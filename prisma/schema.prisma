generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  phone            String?
  emailVerified    DateTime?         @map("email_verified")
  role                   String             @default("USER")
  hasProBook             Boolean            @default(false) @map("has_pro_book")
  proToolsExpiredAt      DateTime?          @map("pro_tools_expired_at")
  proAutomationExpiredAt DateTime?          @map("pro_automation_expired_at")
  proRisetExpiredAt      DateTime?          @map("pro_riset_expired_at")
  image                  String?
  googleApiKey     String?           @map("google_api_key")
  onboardingCompleted Boolean           @default(false) @map("onboarding_completed")
  preferences         Json?
  accounts         Account[]
  bioBuilders      BioBuilder[]
  contentCalendars ContentCalendar[]
  masterBlueprints MasterBlueprint[]
  sessions         Session[]
  usages           Usage[]
  favorites        Favorite[]
  reviews          Review[]
  orders           Order[]
  ownedProducts    UserOwnedProduct[]
  instagramAccounts InstagramAccount[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Feature {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  isProOnly   Boolean  @default(false) @map("is_pro_only")
  usages      Usage[]

  @@map("features")
}

model Usage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  featureId String   @map("feature_id")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@map("usages")
}

model MasterBlueprint {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  inputData Json     @map("input_data")
  aiResult  Json     @map("ai_result")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("master_blueprints")
}

model NicheReference {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  data      Json     @map("data")
  nama      String   @map("nama")

  @@map("niche_references")
}

model BioBuilder {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  username    String?
  profileName String?
  bioText     String?
  avatarUrl   String?
  suggestions Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bio_builders")
}

model ContentCalendar {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("content_calendars")
}

model AiModel {
  id        String   @id @default(cuid())
  modelId   String   @unique @map("model_id")
  name      String
  provider  String   @default("google")
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  isFallback Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_models")
}

model CarouselStyleArt {
  id              String   @id @default(cuid())
  kode            String   @unique
  namaLabel       String   @map("nama_label")
  deskripsiPrompt String   @map("deskripsi_prompt")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("carousel_style_arts")
}

model CarouselFont {
  id              String   @id @default(cuid())
  kode            String   @unique
  namaLabel       String   @map("nama_label")
  deskripsiPrompt String   @map("deskripsi_prompt")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("carousel_fonts")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model DigitalCategory {
  id          String           @id @default(cuid())
  name        String
  description String?
  slug        String           @unique
  icon        String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  products    DigitalProduct[]

  @@map("digital_categories")
}

model DigitalProduct {
  id          String          @id @default(cuid())
  vouchers         Voucher[]
  categoryId  String          @map("category_id")
  title       String
  price       Int             @default(0)
  originalPrice Int?          @default(0)
  pageCount   Int?            @default(0)
  description String?
  slug        String          @unique
  coverUrl    String?
  coverUrl2   String?
  coverUrl3   String?
  fileUrl     String?
  language    String?         @default("Indonesia")
  formatType  String?         @default("PDF / Digital")
  author      String?         @default("Admin")
  isProOnly   Boolean         @default(false)
  accessLevel String          @default("FREE")
  isDownloadable Boolean      @default(false)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  category    DigitalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
  reviews     Review[]
  orders      Order[]
  analytics   ProductAnalytics[]
  owners      UserOwnedProduct[]

  @@index([categoryId])
  @@index([isActive])
  @@map("digital_products")
}

model Favorite {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  digitalProductId String         @map("digital_product_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([userId, digitalProductId])
  @@index([digitalProductId])
  @@map("favorites")
}

model Review {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  digitalProductId String         @map("digital_product_id")
  rating           Int            @default(5)
  comment          String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([userId, digitalProductId])
  @@index([digitalProductId])
  @@map("reviews")
}


model Order {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  digitalProductId String?        @map("digital_product_id")
  orderType        String         @default("EBOOK") // EBOOK, PRO_SUBSCRIPTION
  amount           Int
  status           String         @default("PENDING") // PENDING, SUCCESS, FAILED
  paymentUrl       String?
  midtransId       String?        @unique
  paymentMethod    String?        @map("payment_method")
  addonIds         String[]       @default([])
  voucherCode      String?        @map("voucher_code")
  discountAmount   Int            @default(0) @map("discount_amount")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          DigitalProduct? @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([digitalProductId])
  @@map("orders")
}

model ProductAnalytics {
  id               String         @id @default(cuid())
  digitalProductId String         @map("digital_product_id")
  date             DateTime       @db.Date
  views            Int            @default(0)
  clicks           Int            @default(0)
  
  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([digitalProductId, date])
  @@index([date])
  @@map("product_analytics")
}

model UserOwnedProduct {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  digitalProductId String         @map("digital_product_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([userId, digitalProductId])
  @@index([digitalProductId])
  @@map("user_owned_products")
}


model Voucher {
  id               String         @id @default(cuid())
  code             String
  discountType     String         @default("PERCENTAGE")
  discountValue    Int            
  isActive         Boolean        @default(true)
  digitalProductId String         @map("digital_product_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([code, digitalProductId])
  @@map("vouchers")
}

model InstagramAccount {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  instagramId     String   @unique @map("instagram_id")
  username        String
  name            String?
  profileName     String?  @map("profile_name")
  profilePicUrl   String?  @map("profile_pic_url")
  accessToken     String   @db.Text @map("access_token")
  pageId          String?  @map("page_id")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules           InstagramAutomationRule[]
  logs            InstagramAutomationLog[]

  @@index([userId])
  @@index([pageId])
  @@map("instagram_accounts")
}

model InstagramAutomationRule {
  id              String   @id @default(cuid())
  accountId       String   @map("account_id")
  name            String
  triggerType     String   @default("ALL_POSTS") // ALL_POSTS, SPECIFIC_POST
  specificPostId  String?  @map("specific_post_id")
  keywords        String[] @default([])
  commentReplies  String[] @default([])
  dmMessage       String   @db.Text
  buttonText      String?  @map("button_text")
  buttonUrl       String?  @map("button_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account         InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  logs            InstagramAutomationLog[]

  @@index([accountId, isActive])
  @@map("instagram_automation_rules")
}

model InstagramAutomationLog {
  id                 String   @id @default(cuid())
  accountId          String   @map("account_id")
  ruleId             String?  @map("rule_id")
  fromUsername       String   @map("from_username")
  commentText        String   @map("comment_text")
  commentId          String   @map("comment_id")
  dmStatus           String   @default("SENT") // SENT, FAILED
  replyCommentStatus String   @default("SENT") // SENT, FAILED, SKIPPED
  errorMessage       String?  @map("error_message")
  createdAt          DateTime @default(now()) @map("created_at")

  account            InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rule               InstagramAutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([accountId, commentId])
  @@index([accountId, createdAt])
  @@index([ruleId])
  @@map("instagram_automation_logs")
}


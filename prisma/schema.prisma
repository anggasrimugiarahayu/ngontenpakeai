generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  phone            String?
  emailVerified    DateTime?         @map("email_verified")
  image            String?
  googleApiKey     String?           @map("google_api_key")
  accounts         Account[]
  bioBuilders      BioBuilder[]
  contentCalendars ContentCalendar[]
  masterBlueprints MasterBlueprint[]
  sessions         Session[]
  usages           Usage[]
  favorites        Favorite[]
  reviews          Review[]
  orders           Order[]
  ownedProducts    UserOwnedProduct[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Feature {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  isProOnly   Boolean  @default(false) @map("is_pro_only")
  usages      Usage[]

  @@map("features")
}

model Usage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  featureId String   @map("feature_id")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureId])
  @@map("usages")
}

model MasterBlueprint {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  inputData Json     @map("input_data")
  aiResult  Json     @map("ai_result")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("master_blueprints")
}

model NicheReference {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  data      Json     @map("data")
  nama      String   @map("nama")

  @@map("niche_references")
}

model BioBuilder {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  username    String?
  profileName String?
  bioText     String?
  avatarUrl   String?
  suggestions Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bio_builders")
}

model ContentCalendar {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("content_calendars")
}

model AiModel {
  id        String   @id @default(cuid())
  modelId   String   @unique @map("model_id")
  name      String
  provider  String   @default("google")
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_models")
}

model CarouselStyleArt {
  id              String   @id @default(cuid())
  kode            String   @unique
  namaLabel       String   @map("nama_label")
  deskripsiPrompt String   @map("deskripsi_prompt")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("carousel_style_arts")
}

model CarouselFont {
  id              String   @id @default(cuid())
  kode            String   @unique
  namaLabel       String   @map("nama_label")
  deskripsiPrompt String   @map("deskripsi_prompt")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("carousel_fonts")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model DigitalCategory {
  id          String           @id @default(cuid())
  name        String
  description String?
  slug        String           @unique
  icon        String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  products    DigitalProduct[]

  @@map("digital_categories")
}

model DigitalProduct {
  id          String          @id @default(cuid())
  categoryId  String          @map("category_id")
  title       String
  price       Int             @default(0)
  description String?
  slug        String          @unique
  coverUrl    String?
  coverUrl2   String?
  coverUrl3   String?
  fileUrl     String?
  isProOnly   Boolean         @default(false)
  accessLevel String          @default("FREE")
  isDownloadable Boolean      @default(false)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  category    DigitalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
  reviews     Review[]
  orders      Order[]
  analytics   ProductAnalytics[]
  owners      UserOwnedProduct[]

  @@map("digital_products")
}

model Favorite {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  digitalProductId String         @map("digital_product_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([userId, digitalProductId])
  @@map("favorites")
}

model Review {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  digitalProductId String         @map("digital_product_id")
  rating           Int            @default(5)
  comment          String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([userId, digitalProductId])
  @@map("reviews")
}


model Order {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  digitalProductId String?        @map("digital_product_id")
  orderType        String         @default("EBOOK") // EBOOK, PRO_SUBSCRIPTION
  amount           Int
  status           String         @default("PENDING") // PENDING, SUCCESS, FAILED
  paymentUrl       String?
  midtransId       String?        @unique
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          DigitalProduct? @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model ProductAnalytics {
  id               String         @id @default(cuid())
  digitalProductId String         @map("digital_product_id")
  date             DateTime       @db.Date
  views            Int            @default(0)
  clicks           Int            @default(0)
  
  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([digitalProductId, date])
  @@map("product_analytics")
}

model UserOwnedProduct {
  id               String         @id @default(cuid())
  userId           String         @map("user_id")
  digitalProductId String         @map("digital_product_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)

  @@unique([userId, digitalProductId])
  @@map("user_owned_products")
}
